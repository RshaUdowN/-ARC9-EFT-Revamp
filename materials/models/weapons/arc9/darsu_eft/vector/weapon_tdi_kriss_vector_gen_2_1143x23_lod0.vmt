"VertexLitGeneric"
{
    "$basetexture"      "models/weapons/arc9/darsu_eft/vector/weapon_tdi_kriss_vector_gen_2_1143x23_LOD0_diff"
    "$bumpmap"          "models/weapons/arc9/darsu_eft/vector/weapon_tdi_kriss_vector_gen_2_1143x23_LOD0_nrm"
	"$phongexponenttexture"		"sprites/white"
	"$phongwarptexture"			"models/weapons/arc9/darsu_eft/phongwarp_metal2"
	"$color2"					"[0.75 0.75 0.75]"

	"$envmap"					"env_cubemap"
	"$envmapfresnel"			".25"
	"$envmaptint"				".06"

	"$phong"					"1"
	"$phongexponent"			"3"
	"$phongboost"				"5"
	"$phongfresnelranges"		"[0.32 0.72 0.99]"
	"$phongalbedotint"			"1"

	"$rimlight"					"1"
	"$rimlightexponent"			"10"
	"$rimlightboost"			"3"
	"$rimmask"					"1"

	"$DEM_TintScale" 			".06" // Color scaling essentially, if you want default envmap tint, leave this as is
	"$DEM_Multiplier" 			"1" // Multiplies the output, should change this based on other $envmap settings that alter the strength/color
    
    "$detailblendmode" "4"
    "$detailblendfactor" "0.5"
    "$detailscale" "1.75"

    "$detailangle" 90.0
    "$attname" ""

	Proxies
	{
		"DynamicEnvMap"
		{
			resultVar	"$envmaptint"
		}
        "Arc9CustomCamoAdvanced" 
        {
            "camoTexture" $detail
            "camoScale" $detailscale
            "camoAngle" $detailangle
            "camoBlendMode" $detailblendmode
            "camoBlendFactor" $detailblendfactor
            "phonk" $phongboost
            "color" "[0.99 0.99 0.99]"
        }

        "TextureTransform"
        {
            "rotateVar" "$detailangle"
            "resultVar" "$detailtexturetransform"
        }
    }
}
//Material setup by Shadow_RUN.