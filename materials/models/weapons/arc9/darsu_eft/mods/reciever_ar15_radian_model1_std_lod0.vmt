"VertexLitGeneric"
{
    "$basetexture"      "models/weapons/arc9/darsu_eft/mods/reciever_ar15_radian_model1_std_LOD0_diff"
    "$bumpmap"          "models/weapons/arc9/darsu_eft/mods/reciever_ar15_radian_model1_std_LOD0_nrm"
	"$phongexponenttexture"		"models/weapons/arc9/darsu_eft/exp"
	"$phongwarptexture"			"models/weapons/arc9/darsu_eft\phongwarp_metal2"
	"$color2"					"[0.35 0.35 0.35]"

	"$envmap"					"env_cubemap"
	"$envmapfresnel"			".5"
	"$envmaptint"				".2"

	"$phong"					"1"
	"$phongexponent"			"15"
	"$phongboost"				"5"
	"$phongfresnelranges"		"[0.32 0.72 0.99]"
	"$phongalbedotint"			"1"

	"$rimlight"					"1"
	"$rimlightexponent"			"100"
	"$rimlightboost"			"10"
	"$rimmask"					"1"

	"$DEM_TintScale" 			".2" // Color scaling essentially, if you want default envmap tint, leave this as is
	"$DEM_Multiplier" 			"1" // Multiplies the output, should change this based on other $envmap settings that alter the strength/color
    
    "$detailblendmode" "4"
    "$detailblendfactor" "3"
    "$detailscale" "1.0"

    "$detailangle" 0.0
    "$attname" ""

	Proxies
	{
		"DynamicEnvMap"
		{
			resultVar	"$envmaptint"
		}
       "Arc9CustomCamoAdvanced" 
        {
            "camoTexture" $detail
            "camoScale" $detailscale
            "camoAngle" $detailangle
            "camoBlendMode" $detailblendmode
            "camoBlendFactor" $detailblendfactor
            "phonk" $envmaptint
            "color" "[0.99 0.99 0.99]"
		}
        "TextureTransform"
        {
            "rotateVar" "$detailangle"
            "resultVar" "$detailtexturetransform"
        }
    }
}
//Material setup by Shadow_RUN.